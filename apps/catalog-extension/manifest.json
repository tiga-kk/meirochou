{
  "manifest_version": 3,
  "name": "ComiPath Catalog Sender",
  "version": "0.1.0",
  "description": "Send the current circle space and Twitter account from the supported catalog page to your GAS sheet.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://classic-webcatalog.circle.ms/CircleRapid/Cut2*",
    "https://classic-webcatalog.circle.ms/Circle/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://classic-webcatalog.circle.ms/CircleRapid/Cut2*",
        "https://classic-webcatalog.circle.ms/Circle/*"
      ],
      "js": [
        "lib/catalog-shortcut.js",
        "lib/catalog-extractor.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "action": { "default_popup": "popup.html" },
  "commands": {
    "send-catalog": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Alt+S"
      },
      "description": "現在のカタログをGASへ送信"
    }
  }
}
