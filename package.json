{
  "name": "meirochou",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck:webapp": "tsc -p apps/webapp/tsconfig.json --noEmit",
    "check:webapp": "node scripts/check-webapp-architecture.mjs && npm run typecheck:webapp",
    "dev:webapp": "vite --host 127.0.0.1",
    "dev:webapp:private": "vite --mode private --host 127.0.0.1",
    "build:webapp": "vite build",
    "build:webapp:private": "vite build --mode private",
    "preview:webapp": "vite preview --host 127.0.0.1",
    "serve:webapp:e2e": "vite --host 127.0.0.1 --port 4173",
    "verify:webapp:build": "node scripts/verify-webapp-build.mjs",
    "check:webapp:architecture": "node scripts/check-webapp-architecture.mjs",
    "benchmark:c108-routing": "node scripts/benchmark-c108-routing.mjs",
    "test:route-guidance": "vitest run --root . tests/start-route-guidance.test.ts tests/resume-route-guidance.test.ts tests/finish-current-circle.test.ts tests/route-guidance-session.test.ts tests/route-guidance-controller.test.ts tests/route-guidance-screen-model.test.ts",
    "test:task-08-dom-views": "vitest run --root . tests/feature-dom-views.test.ts tests/navigation-view-model-split.test.ts",
    "test:phase-05d-regressions": "vitest run --root . tests/pending-gas-update-background-process.test.ts tests/send-pending-gas-updates.test.ts",
    "test:webapp": "vitest run --root . --config vitest.webapp.config.ts",
    "verify:webapp": "npm run test:webapp && npm run test:route-guidance && npm run test:phase-05d-regressions && npm run check:webapp && npm run build:webapp && npm run verify:webapp:build",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "build:gas": "node scripts/build-public-gas.mjs",
    "test:gas": "vitest run --root . tests/gas-contract.test.mjs tests/gas-build.test.mjs",
    "verify:gas": "node scripts/build-public-gas.mjs --check && npm run test:gas",
    "verify": "npm run verify:webapp && npm run verify:gas",
    "test:e2e:ci": "scripts/run-e2e-in-ci-container.sh",
    "test:e2e:ci:update": "scripts/run-e2e-in-ci-container.sh --update-snapshots"
  },
  "volta": {
    "node": "22.14.0",
    "npm": "10.9.2"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@playwright/test": "^1.61.1",
    "happy-dom": "^20.10.6",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
